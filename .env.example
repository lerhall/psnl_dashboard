# Copy this file to .env.local and fill in the values.
# See docs/calendar.md for how to get the Outlook links.

# --- Calendar -------------------------------------------------------------
# Published ICS links from Outlook (Settings > Calendar > Shared calendars >
# Publish a calendar). webcal:// links are fine; they're converted to https://.
OUTLOOK_CALENDAR_1_URL=
OUTLOOK_CALENDAR_1_NAME=Personal
OUTLOOK_CALENDAR_2_URL=
OUTLOOK_CALENDAR_2_NAME=Uni

# --- General --------------------------------------------------------------
# IANA timezone used for "today", due dates and calendar times
DASHBOARD_TIMEZONE=Europe/London

# --- Supabase -------------------------------------------------------------
# From Project Settings > API Keys (the new key system, not the legacy
# anon / service_role JWT keys).
SUPABASE_URL=
# Publishable key (sb_publishable_...): browser-safe, optional, not used by
# the app yet (row-level security blocks it from every table).
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): REQUIRED. Server-only; bypasses row-level
# security. Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=
